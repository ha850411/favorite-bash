#!/usr/bin/env zsh
# ==============================================================================
# Favorite Bash - gh PR Scan Tool (pr-scan)
# 快速跨 Repositories 掃描分支、檢查檔案變更並批次發起/合併 PR
# 支援 lab/stg/prod 環境分支自動對應、static 分支獨立處理
# ==============================================================================

_PR_SCAN_RED=$'\033[1;31m'
_PR_SCAN_GREEN=$'\033[1;32m'
_PR_SCAN_YELLOW=$'\033[1;33m'
_PR_SCAN_CYAN=$'\033[1;36m'
_PR_SCAN_BOLD=$'\033[1m'
_PR_SCAN_DIM=$'\033[2m'
_PR_SCAN_RESET=$'\033[0m'

# Dynamically locate the configuration file (prioritize project repo & favorite-bash repo)
function _pr_scan_find_config_file() {
  local project_root=""
  project_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

  # 1. Search in current working directory or git project repository
  if [[ -f "$PWD/.pr-scan.json" ]]; then
    echo "$PWD/.pr-scan.json"
    return 0
  elif [[ -f "$PWD/pr-scan.json" ]]; then
    echo "$PWD/pr-scan.json"
    return 0
  elif [[ -n "$project_root" && "$project_root" != "$HOME" ]]; then
    if [[ -f "${project_root}/.pr-scan.json" ]]; then
      echo "${project_root}/.pr-scan.json"
      return 0
    elif [[ -f "${project_root}/pr-scan.json" && "${project_root}" != "${HOME}/.local" ]]; then
      echo "${project_root}/pr-scan.json"
      return 0
    fi
  fi

  # 2. Search tool directory config (favorite-bash repo config)
  local script_dir="${0:A:h}"
  local tool_dir="${script_dir:h}"
  if [[ -f "${tool_dir}/pr-scan.json" ]]; then
    echo "${tool_dir}/pr-scan.json"
    return 0
  fi

  # 3. Search user home config ~/.config/favorite-bash/pr-scan.json
  if [[ -f "${HOME}/.config/favorite-bash/pr-scan.json" ]]; then
    echo "${HOME}/.config/favorite-bash/pr-scan.json"
    return 0
  elif [[ -f "${HOME}/.pr-scan.json" ]]; then
    echo "${HOME}/.pr-scan.json"
    return 0
  fi

  # 4. Default creation path
  echo "${tool_dir}/pr-scan.json"
}

# Ensure configuration file exists with default values
function _pr_scan_ensure_config() {
  local config_path
  config_path="$(_pr_scan_find_config_file)"

  local config_dir="${config_path:h}"
  if [[ ! -d "$config_dir" ]]; then
    mkdir -p "$config_dir"
  fi

  if [[ ! -f "$config_path" ]]; then
    local default_repo=""
    default_repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo "owner/example-repo")"
    cat <<EOF > "$config_path"
{
  "default_target_base": "develop",
  "default_environments": {
    "lab": "lab",
    "stg": "staging",
    "prod": "master"
  },
  "tracked_repos": [
    "${default_repo}"
  ],
  "repos": {
    "${default_repo}": {
      "default_base": "develop",
      "environments": {
        "lab": "lab",
        "stg": "staging",
        "prod": "master"
      },
      "branch_rules": [
        {
          "pattern": "release/*",
          "base": "develop"
        }
      ]
    }
  }
}
EOF
    echo "${_PR_SCAN_CYAN}💡 已建立設定檔：${_PR_SCAN_BOLD}${config_path}${_PR_SCAN_RESET}"
    echo "${_PR_SCAN_DIM}您可以編輯此設定檔來新增各 Repository 不同的 lab/stg/prod 環境分支與預設 Base 規則。${_PR_SCAN_RESET}\n"
  fi
}

# Read tracked repos array from config
function _pr_scan_get_tracked_repos() {
  _pr_scan_ensure_config
  local config_path
  config_path="$(_pr_scan_find_config_file)"
  python3 -c "
import json, sys
try:
    with open('${config_path}', 'r', encoding='utf-8') as f:
        data = json.load(f)
    repos = []
    if 'tracked_repos' in data and isinstance(data['tracked_repos'], list):
        repos.extend(data['tracked_repos'])
    if 'repos' in data and isinstance(data['repos'], dict):
        repos.extend(data['repos'].keys())

    seen = set()
    for r in repos:
        if r and isinstance(r, str) and r not in seen:
            seen.add(r)
            print(r)
except Exception:
    pass
"
}

# Main entry point
emulate -L zsh
setopt multibyte extendedglob

if ! command -v gh &>/dev/null; then
  echo "${_PR_SCAN_RED}❌ 錯誤：未安裝 GitHub CLI ('gh')。${_PR_SCAN_RESET}"
  echo "請使用 'brew install gh' 安裝並先執行 'gh auth login' 登入。"
  exit 1
fi

_pr_scan_ensure_config
current_config_file="$(_pr_scan_find_config_file)"

arg_repo=""
arg_base_of_b=""
arg_env=""
arg_title=""
arg_body=""
is_draft=false
auto_yes=false
do_auto_merge=true
show_help=false

positional=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -r|--repo)
      arg_repo="$2"
      shift 2
      ;;
    -b|--base)
      arg_base_of_b="$2"
      shift 2
      ;;
    -e|--env|--environment)
      arg_env="$2"
      shift 2
      ;;
    -t|--title)
      arg_title="$2"
      shift 2
      ;;
    -m|--body)
      arg_body="$2"
      shift 2
      ;;
    -d|--draft)
      is_draft=true
      shift
      ;;
    -M|--merge|--auto-merge)
      do_auto_merge=true
      shift
      ;;
    --no-merge)
      do_auto_merge=false
      shift
      ;;
    -y|--yes)
      auto_yes=true
      shift
      ;;
    -h|--help)
      show_help=true
      shift
      ;;
    help)
      show_help=true
      shift
      ;;
    -*)
      echo "${_PR_SCAN_RED}❌ 未知的選項: $1${_PR_SCAN_RESET}"
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

if [[ "$show_help" == true ]]; then
  echo "${_PR_SCAN_BOLD}${_PR_SCAN_CYAN}pr-scan - GitHub PR 快速自動掃描與合併工具${_PR_SCAN_RESET}"
  echo ""
  echo "${_PR_SCAN_BOLD}使用方式：${_PR_SCAN_RESET}"
  echo "  pr-scan [來源分支 A] [目標分支 B 或環境: lab/stg/prod] [選項]"
  echo ""
  echo "${_PR_SCAN_BOLD}選項：${_PR_SCAN_RESET}"
  echo "  -e, --env <lab|stg|prod>    指定目標環境 (自動對應各 Repo 的環境分支名稱，如 lab/project, staging, master 等)"
  echo "  -r, --repo <owner/repo>     只針對特定的 GitHub Repository 進行操作"
  echo "  -b, --base <branch>         當目標分支 B 不存在時，強制指定建立 B 分支所 base 的來源分支"
  echo "  -M, --merge, --auto-merge   PR 建立或偵測已存在時，自動直接執行 PR Merge (預設開啟)"
  echo "  --no-merge                  關閉自動 Merge，僅發起/檢查 PR"
  echo "  -t, --title <title>         指定 PR 標題"
  echo "  -m, --body <body>           指定 PR 內容"
  echo "  -d, --draft                 開立為 Draft PR"
  echo "  -y, --yes                   跳過互動確認直接執行"
  echo "  -h, --help                  顯示此說明訊息"
  echo ""
  echo "${_PR_SCAN_BOLD}範例：${_PR_SCAN_RESET}"
  echo "  pr-scan feature/SERU-12705 lab             # 掃描並發起至各 Repo 的 Lab 分支 (支援 104crm-b 的 project 與 static)"
  echo "  pr-scan feature/SERU-12705 stg             # 掃描並發起至各 Repo 的 STG (staging) 分支"
  echo "  pr-scan feature/SERU-12705 prod            # 掃描並發起至各 Repo 的 PROD (master/prod) 分支"
  echo "  pr-scan feature/SERU-12705 release/SERVICE-0811"
  echo "  pr-scan feature/SERU-12705 -e lab -M"
  echo "  pr-scan -r 104corp/104crm-b feature/SERU-12705 lab"
  exit 0
fi

branch_a="${positional[1]}"
branch_b="${positional[2]}"

# 若指定了 -e/--env 但未給 branch_b，自動填入 arg_env
if [[ -n "$arg_env" && -z "$branch_b" ]]; then
  branch_b="$arg_env"
fi

if [[ -z "$branch_a" ]]; then
  current_git_branch="$(git branch --show-current 2>/dev/null || true)"
  if [[ -n "$current_git_branch" ]]; then
    printf "${_PR_SCAN_YELLOW}請輸入來源分支 (Branch A) [預設: %s]: ${_PR_SCAN_RESET}" "$current_git_branch"
    read -r input_a
    branch_a="${input_a:-$current_git_branch}"
  else
    while [[ -z "$branch_a" ]]; do
      printf "${_PR_SCAN_YELLOW}請輸入來源分支 (Branch A): ${_PR_SCAN_RESET}"
      read -r branch_a
    done
  fi
fi

while [[ -z "$branch_b" ]]; do
  printf "${_PR_SCAN_YELLOW}請輸入目標分支或環境 (lab / stg / prod 或自訂分支名稱): ${_PR_SCAN_RESET}"
  read -r branch_b
done

# 檢查是否輸入同名分支 (若為環境名則略過此限制)
case "${branch_b:l}" in
  lab|stg|staging|prod|production)
    # 環境別名，無需強制防同名檢查
    ;;
  *)
    if [[ "$branch_a" == "$branch_b" ]]; then
      echo "${_PR_SCAN_RED}❌ 來源分支 A 和目標分支 B 不能相同 (${branch_a})！${_PR_SCAN_RESET}"
      exit 1
    fi
    ;;
esac

script_dir="${0:A:h}"
tool_dir="${script_dir:h}"
python_helper="${tool_dir}/lib/pr_scan.py"

if [[ ! -f "$python_helper" ]]; then
  echo "${_PR_SCAN_RED}❌ 錯誤：找不到 pr_scan.py (${python_helper})${_PR_SCAN_RESET}"
  exit 1
fi

python3 "$python_helper" \
  "$current_config_file" \
  "$branch_a" \
  "$branch_b" \
  "$arg_repo" \
  "$arg_base_of_b" \
  "$arg_title" \
  "$arg_body" \
  "$is_draft" \
  "$auto_yes" \
  "$do_auto_merge" \
  "$arg_env"
